# GABARIT — ne jamais remplir ce fichier. Les vraies valeurs vont dans .env.local
# (ou .env), qui sont ignorés par git. Celui-ci sert juste à documenter les
# variables attendues, et il a vocation à être partagé.

# ---------------------------------------------------------------------------
# Domaine public du site — sert aux URLs canoniques, au sitemap, à robots.txt
# et à l'image de partage social. Sans slash final.
# Sur Vercel, la variable VERCEL_PROJECT_PRODUCTION_URL prend le relais
# automatiquement ; ne renseigner celle-ci qu'avec un domaine personnalisé.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=


# ---------------------------------------------------------------------------
# Chat IA « moi ».
# Le chat reste invisible/désactivé tant que ces variables ne sont pas définies.
# ---------------------------------------------------------------------------

# Le widget s'affiche dès qu'un fournisseur ET sa clé sont renseignés ci-dessous.
# Il n'y a pas d'interrupteur séparé : laisser la clé vide suffit à le désactiver.

# Fournisseur : "gemini" (gratuit, sans carte) ou "groq" (gratuit, rapide).
CHAT_PROVIDER=gemini

# Clé du fournisseur choisi (une seule suffit).
GEMINI_API_KEY=
GROQ_API_KEY=

# Modèle optionnel. Défauts : gemini-flash-latest (Gemini) et
# openai/gpt-oss-120b (Groq). Sur Groq, éviter llama-3.1-8b-instant : il tient
# mal la persona (vouvoiement, refus du hors-sujet contourné).
# CHAT_MODEL=


# ---------------------------------------------------------------------------
# Espace privé /admin — pilotage de la disponibilité affichée dans le hero.
# Sans ces deux variables, /admin se déclare en veille et refuse toute écriture.
# ---------------------------------------------------------------------------

# Mot de passe unique de connexion à /admin.
ADMIN_PASSWORD=

# Secret de signature du cookie de session (chaîne aléatoire longue).
# Génération : openssl rand -base64 32
ADMIN_SESSION_SECRET=


# ---------------------------------------------------------------------------
# Stockage de la disponibilité — Upstash Redis, offre gratuite, API REST.
# Absentes, les modifications faites dans /admin restent en mémoire du serveur
# (pratique en local) et disparaissent au redémarrage.
# ---------------------------------------------------------------------------

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
